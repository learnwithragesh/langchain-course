# Copy this file to `.env` and edit. The course works with NO .env at all
# (it defaults to your local Ollama models).

# ---- Which chat model to use (format "provider:model") ----
LC_CHAT_MODEL=ollama:llama3.1
# LC_CHAT_MODEL=anthropic:claude-sonnet-5
# LC_CHAT_MODEL=openai:gpt-4.1-mini

# ---- Which embedding model to use (lessons 07+) ----
LC_EMBED_MODEL=ollama:nomic-embed-text

# ---- API keys (only needed for cloud providers) ----
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ---- Optional: LangSmith tracing (see lesson 00 / 13) ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langchain-course
